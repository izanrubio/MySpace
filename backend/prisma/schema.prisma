// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Usuario para autenticación privada
model User {
  id                String   @id @default(uuid())
  email             String   @unique
  password          String? // Opcional para usuarios OAuth
  name              String
  githubId          String?  @unique // ID de GitHub para OAuth
  githubUsername    String? // Username de GitHub
  githubAccessToken String? // Token de acceso de GitHub para API
  avatarUrl         String? // URL del avatar
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  repos          Repository[]
  folders        Folder[]
  projects       Project[]
  languages      Language[]
  sharedProjects ProjectShare[]
  notifications  Notification[]
}

// Repositorios Git
model Repository {
  id          String   @id @default(uuid())
  name        String
  url         String
  deployUrl   String? // URL de la página desplegada (solo si está activo)
  description String?
  technology  String?
  tags        String[] // Array de tags
  isPrivate   Boolean  @default(false)
  status      String   @default("activo") // activo, archivado, programando
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId   String
  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects ProjectRepository[]

  @@index([userId])
  @@index([tags])
}

// Carpetas para organizar recursos de IA
model Folder {
  id          String   @id @default(uuid())
  name        String
  description String?
  parentId    String? // Para jerarquía de carpetas
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent      Folder?      @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Folder[]     @relation("FolderHierarchy")
  aiResources AIResource[]

  @@index([userId])
  @@index([parentId])
}

// Recursos de IA
model AIResource {
  id          String   @id @default(uuid())
  name        String
  url         String
  logoUrl     String? // URL del logo/icono
  type        String // web, local, api
  description String?
  tags        String[] // Array de tags
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  folderId String?
  folder   Folder?             @relation(fields: [folderId], references: [id], onDelete: SetNull)
  projects ProjectAIResource[]

  @@index([folderId])
  @@index([tags])
  @@index([type])
}

// Proyectos (grupos de recursos)
model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  notes       String? // Markdown
  status      String   @default("activo") // activo, pausado, completado, archivado
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  repos         ProjectRepository[]
  aiResources   ProjectAIResource[]
  links         ProjectLink[]
  languages     ProjectLanguage[]
  sharedWith    ProjectShare[]      @relation("SharedProjects")
  notifications Notification[]

  @@index([userId])
  @@index([status])
}

// Relación muchos a muchos: Proyecto <-> Repositorio
model ProjectRepository {
  id        String   @id @default(uuid())
  projectId String
  repoId    String
  createdAt DateTime @default(now())

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([projectId, repoId])
  @@index([projectId])
  @@index([repoId])
}

// Relación muchos a muchos: Proyecto <-> Recurso IA
model ProjectAIResource {
  id           String   @id @default(uuid())
  projectId    String
  aiResourceId String
  createdAt    DateTime @default(now())

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  aiResource AIResource @relation(fields: [aiResourceId], references: [id], onDelete: Cascade)

  @@unique([projectId, aiResourceId])
  @@index([projectId])
  @@index([aiResourceId])
}

// Enlaces adicionales en proyectos
model ProjectLink {
  id        String   @id @default(uuid())
  projectId String
  title     String
  url       String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// Relación muchos a muchos: Proyecto <-> Lenguaje
model ProjectLanguage {
  id         String   @id @default(uuid())
  projectId  String
  languageId String
  createdAt  DateTime @default(now())

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([projectId, languageId])
  @@index([projectId])
  @@index([languageId])
}

// Lenguajes de programación (Referencias simples)
model Language {
  id        String   @id @default(uuid())
  name      String
  category  String? // Frontend, Backend, Mobile, Data/IA, Sistemas, Databases, Otros
  image     String? // URL de imagen/icono del lenguaje
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId   String
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects ProjectLanguage[]

  @@index([userId])
}

// Proyectos compartidos con otros usuarios
model ProjectShare {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String   @default("viewer") // viewer, editor
  createdAt DateTime @default(now())

  project Project @relation("SharedProjects", fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

// Notificaciones para los usuarios
model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String // project_share, project_invite, etc.
  title     String
  message   String
  data      Json? // Datos adicionales (projectId, etc.)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String?

  @@index([userId])
  @@index([read])
}
