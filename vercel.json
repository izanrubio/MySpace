{
    "version": 2,
    "installCommand": "npm install && cd backend && npm install",
    "builds": [
        {
            "src": "backend/src/index.js",
            "use": "@vercel/node"
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "backend/src/index.js"
        },
        {
            "source": "/health",
            "destination": "backend/src/index.js"
        },
        {
            "source": "/(.*)",
            "destination": "backend/src/index.js"
        }
    ]
}