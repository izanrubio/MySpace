{
    "version": 2,
    "builds": [
        {
            "src": "backend/src/index.js",
            "use": "@vercel/node"
        },
        {
            "src": "frontend/package.json",
            "use": "@vercel/static-build"
        }
    ],
    "routes": [
        {
            "src": "^/api/(.*)$",
            "dest": "backend/src/index.js"
        },
        {
            "src": "^/health$",
            "dest": "backend/src/index.js"
        },
        {
            "src": "^/assets/(.*)$",
            "dest": "/frontend/assets/$1"
        },
        {
            "src": "^/(.*)$",
            "dest": "/frontend/index.html"
        }
    ]
}