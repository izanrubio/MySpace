{
    "version": 2,
    "builds": [
        {
            "src": "backend/src/index.js",
            "use": "@vercel/node"
        },
        {
            "src": "frontend/package.json",
            "use": "@vercel/static-build"
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "backend/src/index.js"
        },
        {
            "source": "/health",
            "destination": "backend/src/index.js"
        },
        {
            "source": "/assets/(.*)",
            "destination": "frontend/assets/$1"
        },
        {
            "source": "/(.*)",
            "destination": "frontend/index.html"
        }
    ]
}